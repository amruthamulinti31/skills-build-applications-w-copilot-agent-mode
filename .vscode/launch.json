{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OctoFit Backend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev --prefix octofit-tracker/backend",
      "env": { "PORT": "8000" }
    },
    {
      "name": "Launch Vite Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0"
      ],
      "port": 5173,
      "env": {
        "VITE_CODESPACE_NAME": "${env:CODESPACE_NAME}"
      }
    }
  ]
}
